<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>الحمزہ ملک شاپ — کھاتہ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@600;700&family=Noto+Naskh+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FBF5E7;
    --surface: #FFFFFF;
    --ink: #2E2620;
    --muted: #7A6A54;
    --maroon: #8C3B3B;
    --maroon-dark: #6B2626;
    --gold: #B98F2E;
    --gold-soft: #F2E4BE;
    --green: #3F7D57;
    --green-soft: #E1F0E6;
    --red: #C24F3A;
    --red-soft: #F8E1DC;
    --line: #E4D6B2;
    --shadow: 0 4px 16px rgba(46,38,32,0.10);
  }
  *{ box-sizing: border-box; min-width: 0; }
  html, body{ overflow-x: hidden; max-width: 100%; }
  body{
    margin:0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Noto Naskh Arabic', serif;
    font-size: 16px;
    line-height:1.5;
    min-height:100vh;
    padding-bottom: 40px;
  }

  /* ---------- lock screen ---------- */
  .lock-overlay{
    position:fixed; inset:0;
    background: linear-gradient(160deg, var(--maroon-dark), var(--maroon));
    display:flex; align-items:center; justify-content:center;
    z-index:100; padding:20px;
  }
  .lock-overlay.hidden{ display:none; }
  .lock-box{
    background: var(--surface);
    border-radius:18px;
    padding:36px 28px;
    width:100%; max-width:340px;
    text-align:center;
    box-shadow: 0 16px 40px rgba(0,0,0,0.35);
  }
  .lock-box h2{
    font-family:'Noto Nastaliq Urdu', serif;
    color: var(--maroon-dark);
    font-size:1.8rem;
    margin:0 0 10px;
  }
  .lock-box p{ color: var(--muted); font-size:0.95rem; margin:0 0 18px; }
  .lock-box input{
    width:100%;
    font-family:'Noto Naskh Arabic', serif;
    font-size:1.05rem;
    padding:12px 14px;
    border:1.5px solid var(--line);
    border-radius:10px;
    margin-bottom:14px;
    text-align:center;
  }
  .lock-box button{
    width:100%;
    background: var(--maroon);
    color:#fff;
    border:none;
    border-radius:10px;
    padding:12px;
    font-family:'Noto Naskh Arabic', serif;
    font-size:1.05rem;
    font-weight:700;
    cursor:pointer;
  }
  .lock-box button:hover{ background: var(--maroon-dark); }
  .lock-error{ color: var(--red); font-size:0.9rem; margin-top:12px; }

  /* ---------- header ---------- */
  header{
    background: linear-gradient(160deg, var(--maroon), var(--maroon-dark));
    color:#fdf6e6;
    padding: 30px 20px 26px;
    text-align:center;
    border-radius: 0 0 26px 26px;
    box-shadow: var(--shadow);
  }
  header h1{
    font-family:'Noto Nastaliq Urdu', serif;
    font-weight:700;
    font-size: 2.1rem;
    margin:0;
  }
  header .sub{ font-size:1rem; opacity:0.85; margin-top:6px; }

  .wrap{ max-width: 760px; width:100%; margin: 0 auto; padding: 0 16px; }

  /* ---------- summary cards ---------- */
  .summary{ display:flex; gap:12px; margin: 20px 0; }
  .card{
    flex:1; background: var(--surface);
    border:1px solid var(--line); border-radius:14px;
    padding:16px; box-shadow: var(--shadow); text-align:center;
  }
  .card .label{ font-size:0.85rem; color: var(--muted); }
  .card .value{ font-size:1.5rem; font-weight:700; margin-top:4px; }
  .card.due .value{ color: var(--red); }
  .card.count .value{ color: var(--maroon-dark); }

  /* ---------- section blocks ---------- */
  .panel{
    background: var(--surface);
    border:1px solid var(--line); border-radius:14px;
    padding:18px; box-shadow: var(--shadow); margin-bottom:18px;
  }
  .panel h2{
    font-family:'Noto Nastaliq Urdu', serif;
    color: var(--maroon-dark);
    font-size:1.3rem; margin:0 0 12px;
  }

  .field-row{ display:flex; gap:10px; flex-wrap:wrap; }
  .field{ display:flex; flex-direction:column; gap:5px; flex:1; min-width:120px; }
  .field label{ font-size:0.82rem; color: var(--muted); }
  .field input, .field select{
    width:100%;
    font-family:'Noto Naskh Arabic', serif;
    font-size:0.95rem;
    padding:10px 11px;
    border:1.5px solid var(--line);
    border-radius:9px;
    background:#fffdf7;
    color: var(--ink);
  }
  .field input:focus, .field select:focus{ outline:2px solid var(--gold); outline-offset:1px; }
  .field input[readonly]{ background:#f2ecdc; color: var(--muted); }

  .btn{
    border:none; border-radius:9px; padding:11px 18px;
    font-family:'Noto Naskh Arabic', serif; font-size:0.95rem; font-weight:700;
    cursor:pointer;
  }
  .btn-primary{ background: var(--maroon); color:#fff; }
  .btn-primary:hover{ background: var(--maroon-dark); }
  .btn-gold{ background: var(--gold); color:#fff; }
  .btn-green{ background: var(--green); color:#fff; }
  .btn-outline{ background:#fff; color: var(--maroon); border:1.5px solid var(--maroon); }
  .btn-full{ width:100%; margin-top:10px; }
  .btn-whatsapp{ 
    background: #25D366; 
    color:#fff; 
    border:none;
    border-radius:50%;
    width:34px;
    height:34px;
    font-size:16px;
    cursor:pointer;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    transition:0.2s;
    text-decoration:none;
  }
  .btn-whatsapp:hover{ background: #1da851; }

  /* ---------- staff ---------- */
  .staff-chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
  .staff-chip{
    display:flex; align-items:center; gap:6px;
    background: var(--gold-soft); border:1px solid var(--line);
    border-radius:20px; padding:5px 12px; font-size:0.85rem;
  }
  .staff-chip button{ border:none; background:none; color: var(--red); cursor:pointer; font-size:0.9rem; }
  .staff-empty{ color: var(--muted); font-size:0.85rem; }

  /* ---------- toolbar ---------- */
  .toolbar{ display:flex; gap:10px; margin: 4px 0 14px; }
  .toolbar input[type=search]{
    flex:1; font-family:'Noto Naskh Arabic', serif;
    padding:10px 14px; border:1.5px solid var(--line);
    border-radius:24px; background: var(--surface); font-size:0.95rem;
  }

  /* ---------- customer accordion ---------- */
  .customer{
    background: var(--surface);
    border:1px solid var(--line);
    border-radius:14px;
    margin-bottom:14px;
    box-shadow: var(--shadow);
    overflow:hidden;
  }
  .customer summary{
    list-style:none;
    cursor:pointer;
    padding:14px 16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
  }
  .customer summary::-webkit-details-marker{ display:none; }
  
  .cust-name-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cust-name{ font-weight:700; font-size:1.05rem; }
  .cust-balance-header{ 
    font-weight:700; 
    font-size:0.9rem; 
    padding:2px 10px;
    border-radius:12px;
    background: var(--gold-soft);
  }
  .cust-balance-header.due{ color: var(--red); background: var(--red-soft); }
  .cust-balance-header.clear{ color: var(--green); background: var(--green-soft); }
  
  .cust-phone{
    font-size:0.82rem; color: var(--maroon);
    text-decoration:none; display:block; margin-top:2px;
  }
  .cust-balance{ font-weight:700; font-size:1.05rem; white-space:nowrap; }
  .cust-balance.due{ color: var(--red); }
  .cust-balance.clear{ color: var(--green); }
  .chevron{ transition: transform 0.2s ease; color: var(--muted); font-size:1.1rem; }
  .customer[open] .chevron{ transform: rotate(180deg); }

  .cust-body{ border-top:1px solid var(--line); padding:16px; background:#fffdf7; }
  .cust-body h3{ font-size:0.95rem; color: var(--maroon-dark); margin:0 0 10px; }
  .mini-form{ margin-bottom:16px; padding-bottom:16px; border-bottom:1px dashed var(--line); }

  /* Phone & WhatsApp row */
  .contact-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .contact-row .cust-phone {
    margin: 0;
    font-size: 0.95rem;
  }

  .txn-table{ width:100%; border-collapse:collapse; }
  .txn-table th{
    font-size:0.78rem; color: var(--muted); text-align:right;
    padding:6px 4px; border-bottom:1.5px solid var(--line);
  }
  .txn-table td{
    font-size:0.88rem; padding:8px 4px; border-bottom:1px solid var(--line);
    vertical-align:top;
  }
  .txn-table tr:last-child td{ border-bottom:none; }
  .txn-note{ color: var(--ink); }
  .txn-meta{ font-size:0.75rem; color: var(--muted); display:block; margin-top:2px; }
  .txn-amount.credit{ color: var(--red); font-weight:700; }
  .txn-amount.payment{ color: var(--green); font-weight:700; }
  .txn-del{ border:none; background:none; color: var(--muted); cursor:pointer; font-size:0.8rem; }
  .txn-empty{ color: var(--muted); font-size:0.85rem; padding:10px 0; }

  .del-customer{ text-align:center; margin-top:14px; }
  .del-customer button{ background:none; border:none; color: var(--red); font-size:0.82rem; cursor:pointer; }

  .empty{
    text-align:center; padding:36px 14px; color: var(--muted);
    background: var(--surface); border-radius:14px; box-shadow: var(--shadow);
  }
  footer{ text-align:center; color: var(--muted); font-size:0.8rem; margin-top:24px; }

  /* Bottom sections */
  .bottom-section {
    margin-top: 30px;
    border-top: 2px solid var(--line);
    padding-top: 20px;
  }

  @media (max-width:480px){
    header h1{ font-size:1.7rem; }
    .summary{ flex-direction:row; }
    .field-row{ flex-direction:column; }
    .field{ min-width:100%; }
    .cust-name-wrapper { flex-direction: column; align-items: flex-start; gap: 4px; }
  }
</style>
</head>
<body>

<div class="lock-overlay" id="lockOverlay">
  <div class="lock-box">
    <h2>الحمزہ ملک شاپ</h2>
    <p>کھاتہ دیکھنے کے لیے پاسورڈ درج کریں</p>
    <input type="password" id="lockPassword" placeholder="پاسورڈ" autocomplete="off">
    <button type="button" id="lockSubmit">داخل ہوں</button>
    <div class="lock-error" id="lockError" style="display:none;">غلط پاسورڈ، دوبارہ کوشش کریں</div>
  </div>
</div>

<div id="siteContent" style="display:none;">
  <header>
    <h1>الحمزہ ملک شاپ</h1>
    <div class="sub">کسٹمر ادھار کھاتہ</div>
  </header>

  <div class="wrap">
    <div class="summary">
      <div class="card due">
        <div class="label">کل باقی رقم</div>
        <div class="value" id="totalDue">0</div>
      </div>
      <div class="card count">
        <div class="label">کل کسٹمرز</div>
        <div class="value" id="totalCustomers">0</div>
      </div>
    </div>

    <div class="panel">
      <h2>نیا کسٹمر شامل کریں</h2>
      <div class="field-row">
        <div class="field">
          <label for="newCustName">نام</label>
          <input type="text" id="newCustName" placeholder="مثلاً: احمد بھائی">
        </div>
        <div class="field">
          <label for="newCustPhone">فون نمبر (اختیاری)</label>
          <input type="tel" id="newCustPhone" placeholder="03xxxxxxxxx">
        </div>
      </div>
      <button type="button" class="btn btn-primary btn-full" id="addCustomerBtn">کسٹمر شامل کریں</button>
    </div>

    <div class="toolbar">
      <input type="search" id="searchBox" placeholder="کسٹمر کا نام تلاش کریں...">
    </div>

    <div id="customerList"></div>
    <div class="empty" id="emptyState" style="display:none;">ابھی کوئی کسٹمر شامل نہیں۔ اوپر فارم سے پہلا کسٹمر شامل کریں۔</div>

    <!-- Bottom Section: Staff then Password -->
    <div class="bottom-section">
      <!-- Staff Section -->
      <div class="panel">
        <h2>👥 عملہ کی فہرست</h2>
        <div class="field-row">
          <div class="field">
            <input type="text" id="staffNameInput" placeholder="نام لکھیں، مثلاً: بلال">
          </div>
          <button type="button" class="btn btn-gold" id="staffAddBtn">شامل کریں</button>
        </div>
        <div class="staff-chips" id="staffChips"></div>
      </div>

      <!-- Password Change Section -->
      <div class="panel">
        <h2>🔒 پاسورڈ تبدیل کریں</h2>
        <div class="field-row">
          <div class="field">
            <label for="oldPass">موجودہ پاسورڈ</label>
            <input type="password" id="oldPass" placeholder="موجودہ پاسورڈ">
          </div>
          <div class="field">
            <label for="newPass">نیا پاسورڈ</label>
            <input type="password" id="newPass" placeholder="نیا پاسورڈ">
          </div>
        </div>
        <button type="button" class="btn btn-outline btn-full" id="changePassBtn">پاسورڈ تبدیل کریں</button>
        <div class="lock-error" id="passMsg" style="display:none;"></div>
      </div>
    </div>

    <footer>الحمزہ ملک شاپ — کھاتہ کا ریکارڈ اس براؤزر میں محفوظ ہوتا ہے</footer>
  </div>
</div>

<script>
  const CUSTOMERS_KEY = 'alhamza_customers';
  const TXNS_KEY = 'alhamza_transactions';
  const STAFF_KEY = 'alhamza_ledger_staff';
  const PASSWORD_KEY = 'alhamza_site_password';
  function getPassword(){
    return localStorage.getItem(PASSWORD_KEY) || '1122';
  }
  function setPassword(p){
    localStorage.setItem(PASSWORD_KEY, p);
  }

  let customers = [];
  let txns = [];
  let staff = [];
  let searchTerm = '';

  function loadAll(){
    try{ customers = JSON.parse(localStorage.getItem(CUSTOMERS_KEY) || '[]'); }catch(e){ customers = []; }
    try{ txns = JSON.parse(localStorage.getItem(TXNS_KEY) || '[]'); }catch(e){ txns = []; }
    try{ staff = JSON.parse(localStorage.getItem(STAFF_KEY) || '[]'); }catch(e){ staff = []; }
  }
  function saveCustomers(){ localStorage.setItem(CUSTOMERS_KEY, JSON.stringify(customers)); }
  function saveTxns(){ localStorage.setItem(TXNS_KEY, JSON.stringify(txns)); }
  function saveStaff(){ localStorage.setItem(STAFF_KEY, JSON.stringify(staff)); }

  function escapeHtml(str){
    const div = document.createElement('div');
    div.textContent = str == null ? '' : str;
    return div.innerHTML;
  }
  function escapeAttr(str){ return String(str).replace(/'/g, "\\'"); }
  function newId(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,6); }
  function fmtMoney(n){ return Number(n).toLocaleString('en-US') + ' روپے'; }
  function fmtDate(iso){
    if(!iso) return '';
    const parts = iso.split('-');
    if(parts.length === 3){
      return `${parts[2]}-${parts[1]}-${parts[0]}`;
    }
    return iso;
  }
  function formatDateForMessage(iso){
    if(!iso) return '';
    const parts = iso.split('-');
    if(parts.length === 3){
      const months = ['جنوری', 'فروری', 'مارچ', 'اپریل', 'مئی', 'جون', 'جولائی', 'اگست', 'ستمبر', 'اکتوبر', 'نومبر', 'دسمبر'];
      return `${parts[2]} ${months[parseInt(parts[1])-1]} ${parts[0]}`;
    }
    return iso;
  }
  function nowStamp(){
    const now = new Date();
    const date = now.toISOString().slice(0,10);
    const time = now.toTimeString().slice(0,5);
    return { date, time };
  }

  function customerBalance(custId){
    return txns.filter(t => t.customerId === custId).reduce((sum,t) => {
      return sum + (t.type === 'credit' ? Number(t.amount) : -Number(t.amount));
    }, 0);
  }

  /* ---------- WhatsApp share function with full history ---------- */
  function shareCustomerOnWhatsApp(custId) {
    const cust = customers.find(c => c.id === custId);
    if (!cust) return;
    const balance = customerBalance(custId);
    const phone = cust.phone || 'فون نمبر درج نہیں';
    const name = cust.name;
    
    // Get all transactions for this customer, sorted oldest to newest
    const custTxns = txns.filter(t => t.customerId === custId).sort((a,b) => {
      return (a.date + a.time).localeCompare(b.date + b.time);
    });
    
    // Build message in Urdu with full history
    let message = `📋 *الحمزہ ملک شاپ - مکمل کھاتہ*\n`;
    message += `═══════════════════\n`;
    message += `👤 کسٹمر: ${name}\n`;
    message += `📞 فون: ${phone}\n`;
    message += `═══════════════════\n\n`;
    message += `📅 *لین دین کی تفصیل:*\n`;
    message += `─────────────────\n`;
    
    if(custTxns.length === 0) {
      message += `❌ کوئی لین دین نہیں\n`;
    } else {
      let sr = 1;
      custTxns.forEach(t => {
        const dateStr = formatDateForMessage(t.date);
        const timeStr = t.time || '';
        const typeLabel = t.type === 'credit' ? '📦 ادھار (سامان)' : '💰 وصولی (ادائیگی)';
        const amountStr = t.type === 'credit' ? `+${Number(t.amount).toLocaleString('en-US')}` : `-${Number(t.amount).toLocaleString('en-US')}`;
        const noteStr = t.note ? ` (${t.note})` : '';
        const byStr = t.by ? `\n   👤 عملہ: ${t.by}` : '';
        message += `${sr}. ${dateStr} ${timeStr}\n`;
        message += `   ${typeLabel}${noteStr}\n`;
        message += `   💰 ${amountStr} روپے${byStr}\n\n`;
        sr++;
      });
    }
    
    message += `─────────────────\n`;
    message += `💰 *کل باقی رقم:* ${balance > 0 ? fmtMoney(balance) : 'صاف (کوئی بقایا نہیں)'}\n`;
    message += `═══════════════════\n`;
    message += `📅 تاریخ: ${new Date().toLocaleDateString('ur-PK')}`;
    
    // Use https://wa.me/ which works on all devices
    const encoded = encodeURIComponent(message);
    const url = `https://wa.me/?text=${encoded}`;
    window.open(url, '_blank');
  }

  /* ---------- staff ---------- */
  function renderStaff(){
    const chips = document.getElementById('staffChips');
    if(staff.length === 0){
      chips.innerHTML = '<span class="staff-empty">ابھی کوئی نام شامل نہیں۔</span>';
    } else {
      chips.innerHTML = staff.map(s => `
        <span class="staff-chip">${escapeHtml(s)}<button type="button" onclick="removeStaff('${escapeAttr(s)}')" title="ہٹائیں">×</button></span>
      `).join('');
    }
    // refresh any open select dropdowns for staff
    document.querySelectorAll('.staff-select').forEach(sel => {
      const current = sel.value;
      sel.innerHTML = staff.length
        ? staff.map(s => `<option value="${escapeAttr(s)}">${escapeHtml(s)}</option>`).join('')
        : '<option value="">— پہلے عملہ شامل کریں —</option>';
      if(staff.includes(current)) sel.value = current;
    });
  }
  function removeStaff(name){
    staff = staff.filter(s => s !== name);
    saveStaff();
    renderStaff();
  }
  document.getElementById('staffAddBtn').addEventListener('click', function(){
    const input = document.getElementById('staffNameInput');
    const name = input.value.trim();
    if(!name) return;
    if(!staff.includes(name)) staff.push(name);
    saveStaff();
    input.value = '';
    renderStaff();
  });
  document.getElementById('staffNameInput').addEventListener('keydown', function(ev){
    if(ev.key === 'Enter'){ ev.preventDefault(); document.getElementById('staffAddBtn').click(); }
  });

  /* ---------- add customer ---------- */
  document.getElementById('addCustomerBtn').addEventListener('click', function(){
    const nameInput = document.getElementById('newCustName');
    const phoneInput = document.getElementById('newCustPhone');
    const name = nameInput.value.trim();
    const phone = phoneInput.value.trim();
    if(!name) return;
    customers.push({ id:newId(), name, phone });
    saveCustomers();
    nameInput.value = '';
    phoneInput.value = '';
    render();
  });

  function deleteCustomer(id){
    if(!confirm('کیا آپ واقعی اس کسٹمر اور اس کا پورا ریکارڈ حذف کرنا چاہتے ہیں؟')) return;
    customers = customers.filter(c => c.id !== id);
    txns = txns.filter(t => t.customerId !== id);
    saveCustomers();
    saveTxns();
    render();
  }

  /* ---------- transactions ---------- */
  function addCredit(custId){
    const note = document.getElementById('note-'+custId).value.trim();
    const amount = document.getElementById('amt-'+custId).value;
    const by = document.getElementById('by-'+custId).value;
    if(!amount || Number(amount) <= 0) return;
    const { date, time } = nowStamp();
    txns.push({ id:newId(), customerId:custId, date, time, note, amount, type:'credit', by });
    saveTxns();
    document.getElementById('note-'+custId).value = '';
    document.getElementById('amt-'+custId).value = '';
    render();
  }

  function addPayment(custId){
    const amount = document.getElementById('pay-'+custId).value;
    const by = document.getElementById('payby-'+custId).value;
    if(!amount || Number(amount) <= 0) return;
    const { date, time } = nowStamp();
    txns.push({ id:newId(), customerId:custId, date, time, note:'ادائیگی', amount, type:'payment', by });
    saveTxns();
    document.getElementById('pay-'+custId).value = '';
    render();
  }

  function deleteTxn(id){
    if(!confirm('کیا آپ واقعی یہ اندراج حذف کرنا چاہتے ہیں؟')) return;
    txns = txns.filter(t => t.id !== id);
    saveTxns();
    render();
  }

  /* ---------- render ---------- */
  function staffOptions(){
    return staff.length
      ? staff.map(s => `<option value="${escapeAttr(s)}">${escapeHtml(s)}</option>`).join('')
      : '<option value="">— پہلے عملہ شامل کریں —</option>';
  }

  function renderCustomerCard(cust){
    const balance = customerBalance(cust.id);
    const custTxns = txns.filter(t => t.customerId === cust.id).slice().sort((a,b) => {
      const da = a.date + a.time, db = b.date + b.time;
      return db.localeCompare(da);
    });

    // Balance badge for header
    const balanceBadge = balance > 0 
      ? `<span class="cust-balance-header due">💰 ${fmtMoney(balance)}</span>` 
      : `<span class="cust-balance-header clear">✅ صاف</span>`;

    // Phone with WhatsApp button
    const contactHtml = cust.phone ? `
      <div class="contact-row">
        <a class="cust-phone" href="tel:${escapeAttr(cust.phone)}" onclick="event.stopPropagation()">📞 ${escapeHtml(cust.phone)}</a>
        <button type="button" class="btn-whatsapp" onclick="event.stopPropagation(); shareCustomerOnWhatsApp('${cust.id}')" title="واٹس ایپ پر بھیجیں">
          💬
        </button>
      </div>
    ` : '';

    const rowsHtml = custTxns.length
      ? custTxns.map(t => `
        <tr>
          <td>${fmtDate(t.date)}<span class="txn-meta">${escapeHtml(t.time)}</span></td>
          <td class="txn-note">${escapeHtml(t.note || (t.type === 'credit' ? 'سامان' : 'ادائیگی'))}${t.by ? `<span class="txn-meta">${t.type === 'credit' ? 'دیا: ' : 'وصول: '}${escapeHtml(t.by)}</span>` : ''}</td>
          <td class="txn-amount ${t.type}">${t.type === 'credit' ? '+' : '−'}${Number(t.amount).toLocaleString('en-US')}</td>
          <td><button class="txn-del" onclick="deleteTxn('${t.id}')">حذف</button></td>
        </tr>
      `).join('')
      : `<tr><td colspan="4" class="txn-empty">ابھی کوئی اندراج نہیں</td></tr>`;

    return `
      <details class="customer">
        <summary>
          <div class="cust-name-wrapper">
            <span class="cust-name">${escapeHtml(cust.name)}</span>
            ${balanceBadge}
          </div>
          <div style="display:flex; align-items:center; gap:10px;">
            <span class="chevron">▾</span>
          </div>
        </summary>
        <div class="cust-body">
          ${contactHtml}

          <div class="mini-form">
            <h3>نیا سامان / ادھار درج کریں</h3>
            <div class="field-row">
              <div class="field">
                <label>سامان کی تفصیل</label>
                <input type="text" id="note-${cust.id}" placeholder="مثلاً: چینی، آٹا وغیرہ">
              </div>
              <div class="field">
                <label>رقم</label>
                <input type="number" id="amt-${cust.id}" min="0" placeholder="روپے">
              </div>
              <div class="field">
                <label>دیا کس نے</label>
                <select class="staff-select" id="by-${cust.id}">${staffOptions()}</select>
              </div>
            </div>
            <button type="button" class="btn btn-primary btn-full" onclick="addCredit('${cust.id}')">ادھار درج کریں</button>
          </div>

          <div class="mini-form">
            <h3>رقم وصول ہوئی</h3>
            <div class="field-row">
              <div class="field">
                <label>وصول شدہ رقم</label>
                <input type="number" id="pay-${cust.id}" min="0" placeholder="روپے">
              </div>
              <div class="field">
                <label>وصول کس نے کیا</label>
                <select class="staff-select" id="payby-${cust.id}">${staffOptions()}</select>
              </div>
            </div>
            <button type="button" class="btn btn-green btn-full" onclick="addPayment('${cust.id}')">وصولی درج کریں</button>
          </div>

          <h3>لین دین کی تاریخ</h3>
          <table class="txn-table">
            <thead><tr><th>تاریخ</th><th>تفصیل</th><th>رقم</th><th></th></tr></thead>
            <tbody>${rowsHtml}</tbody>
          </table>

          <div class="del-customer">
            <button type="button" onclick="deleteCustomer('${cust.id}')">یہ کسٹمر حذف کریں</button>
          </div>
        </div>
      </details>
    `;
  }

  function render(){
    const list = document.getElementById('customerList');
    const empty = document.getElementById('emptyState');

    let filtered = customers.filter(c => !searchTerm || c.name.toLowerCase().includes(searchTerm.toLowerCase()));
    filtered.sort((a,b) => customerBalance(b.id) - customerBalance(a.id));

    if(filtered.length === 0){
      list.innerHTML = '';
      empty.style.display = 'block';
    } else {
      empty.style.display = 'none';
      list.innerHTML = filtered.map(renderCustomerCard).join('');
    }

    const totalDue = customers.reduce((sum,c) => {
      const b = customerBalance(c.id);
      return sum + (b > 0 ? b : 0);
    }, 0);
    document.getElementById('totalDue').textContent = fmtMoney(totalDue);
    document.getElementById('totalCustomers').textContent = customers.length;
  }

  document.getElementById('searchBox').addEventListener('input', function(){
    searchTerm = this.value;
    render();
  });

  /* ---------- lock screen ---------- */
  function tryUnlock(){
    const entered = document.getElementById('lockPassword').value;
    if(entered === getPassword()){
      document.getElementById('lockOverlay').classList.add('hidden');
      document.getElementById('siteContent').style.display = 'block';
    } else {
      document.getElementById('lockError').style.display = 'block';
      document.getElementById('lockPassword').value = '';
      document.getElementById('lockPassword').focus();
    }
  }
  document.getElementById('changePassBtn').addEventListener('click', function(){
    const oldPass = document.getElementById('oldPass').value;
    const newPass = document.getElementById('newPass').value;
    const msg = document.getElementById('passMsg');
    msg.style.display = 'block';
    if(oldPass !== getPassword()){
      msg.textContent = 'موجودہ پاسورڈ غلط ہے۔';
      msg.style.color = 'var(--red)';
      return;
    }
    if(!newPass || newPass.length < 2){
      msg.textContent = 'نیا پاسورڈ کم از کم 2 حروف کا ہونا چاہیے۔';
      msg.style.color = 'var(--red)';
      return;
    }
    setPassword(newPass);
    document.getElementById('oldPass').value = '';
    document.getElementById('newPass').value = '';
    msg.textContent = 'پاسورڈ کامیابی سے تبدیل ہو گیا۔';
    msg.style.color = 'var(--green)';
  });

  document.getElementById('lockSubmit').addEventListener('click', tryUnlock);
  document.getElementById('lockPassword').addEventListener('keydown', function(ev){
    if(ev.key === 'Enter'){ ev.preventDefault(); tryUnlock(); }
  });

  loadAll();
  renderStaff();
  render();
</script>
</body>
</html>
